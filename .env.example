# Modelo das variáveis de ambiente. Copie para `.env.local` e preencha.
# `.env.local` já é ignorado pelo git (regra `*.local` no .gitignore).
#
# O prefixo VITE_ é obrigatório: só variáveis com ele chegam ao navegador.
# Isso também quer dizer que TUDO aqui fica visível no código que o
# usuário baixa — nunca ponha a secret key / service_role neste arquivo.

VITE_SUPABASE_URL=https://udrgotkcrephgyunidif.supabase.co

# Settings → API Keys → "Publishable key" (sb_publishable_...).
# Em projetos antigos aparece como "anon public" (eyJ...) — é a mesma.
VITE_SUPABASE_PUBLISHABLE_KEY=

# A tela de login só aparece no build de produção. Ponha `true` para
# conferi-la rodando localmente.
# VITE_EXIGIR_LOGIN=true
